{
  "name": "nprogresse",
  "version": "1.0.0",
  "description": "Minimalist top loading progress bar for modern browsers",
  "type": "module",
  "author": "AkatQuas <295140755@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/AkatQuas/nprogresse#readme",
  "bugs": {
    "url": "https://github.com/AkatQuas/nprogresse/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkatQuas/nprogresse.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "dist/index.js",
  "style": "dist/style.css",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "nprogress",
    "nprogresse",
    "progress",
    "progress-bar",
    "loading",
    "loading-bar"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "vite --config vite.examples.config.ts",
    "examples": "npm run build && npm run serve",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "chai": "^5.2.0",
    "happy-dom": "^17.4.4",
    "jquery": "^3.7.1",
    "less": "^4.3.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^5.0.0"
  }
}
